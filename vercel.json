{
  "buildCommand": "echo 'Prebuilt: dist is committed, prerendered locally. See prerender.mjs.'",
  "installCommand": "echo 'No install needed for a prebuilt deploy.'",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/ai",
      "destination": "/evergreen-legal-ai",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sign/:token",
      "destination": "/index.html"
    },
    {
      "source": "/intake/:token",
      "destination": "/index.html"
    }
  ]
}
